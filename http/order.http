### 1. 강의 주문 생성
POST http://{{host}}/api/v1/orders/lecture
X-User-Id: {{userId}}
X-User-Role: {{userRole}}
Content-Type: application/json

{
  "couponId": null,
  "paymentMethod": "TOSS",
  "items": [
    "c6198b69-015d-477c-a2f4-35c54c777121"
  ]
}

> {%
  client.test("강의 주문 생성 성공", function() {
    client.assert(response.status === 201, "응답 코드가 201이어야 합니다.");
  });
%}

### 2. 결제 완료 이벤트
POST http://{{host}}/test/orders/complete
Content-Type: application/json

{
  "orderId": "{{orderId}}",
  "paymentKey": "test_paymentKey_12345",
  "amount": 30000,
  "approvedAt": "2025-05-09T10:00:00",
  "paymentMethod": "TOSS"
}

### 3. 결제 실패 이벤트
POST http://{{host}}/test/orders/fail
Content-Type: application/json

{
  "orderId": "{{orderId}}",
  "amount": 50000,
  "failedAt": "2025-05-09T10:00:00",
  "failureReason": "잔액 부족"
}

### 4. 결제 취소 이벤트
POST http://{{host}}/test/orders/cancel
Content-Type: application/json

{
  "orderId": "{{orderId}}",
  "amount": 30000,
  "cancelAt": "2025-05-09T10:00:00",
  "cancelReason": "단순 변심"
}

### 주문 목록 전체 조회 (기본 페이징)
GET http://{{host}}/api/v1/orders?page=0&size=10
X-User-Id: {{userId}}

> {%
  client.test("전체 조회 성공", function() {
    client.assert(response.status === 200, "응답 코드가 200이어야 합니다.");
  });
%}

### 주문 목록 조회 (가격 높은 순 정렬)
# OrderSortType.PRICE_DESC ("price,desc") 적용
GET http://{{host}}/api/v1/orders?page=0&size=10&sort=price,desc
X-User-Id: {{userId}}

> {%
  client.test("정렬 조회 성공", function() {
    client.assert(response.status === 200, "응답 코드가 200이어야 합니다.");
  });
%}

### 주문 목록 조회 (상태 필터링: 결제 완료 건만)
# OrderStatus.PAID ("PAID") 적용
GET http://{{host}}/api/v1/orders?page=0&size=10&orderStatus=PAID
X-User-Id: {{userId}}

> {%
  client.test("상태 필터링 조회 성공", function() {
    client.assert(response.status === 200, "응답 코드가 200이어야 합니다.");
  });
%}

### 주문 목록 조회 (정렬 + 상태 필터링 복합)
GET http://{{host}}/api/v1/orders?page=0&size=10&sort=createdAt,asc&orderStatus=COMPLETED
X-User-Id: {{userId}}

> {%
  client.test("복합 조건 조회 성공", function() {
    client.assert(response.status === 200, "응답 코드가 200이어야 합니다.");
  });
%}


### 주문 상세 조회
GET http://{{host}}/api/v1/orders/{{orderId}}
X-User-Id: {{userId}}